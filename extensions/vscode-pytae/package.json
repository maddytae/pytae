{
  "name": "pytae",
  "displayName": "Pytae - Tabular Data DSL",
  "description": "Dark green syntax highlighting, themes, snippets, and tool support for Pytae tabular data manipulation in Python",
  "version": "3.10.4",
  "publisher": "maddytae",
  "author": {
    "name": "Pytae Contributors",
    "url": "https://github.com/maddytae/pytae"
  },
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/maddytae/pytae.git"
  },
  "homepage": "https://github.com/maddytae/pytae",
  "bugs": {
    "url": "https://github.com/maddytae/pytae/issues"
  },
  "keywords": [
    "pytae",
    "polars",
    "pandas",
    "dataframe",
    "mutate",
    "case_when",
    "tabular",
    "dsl",
    "syntax",
    "green"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Themes",
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "grammars": [
      {
        "scopeName": "pytae.injection",
        "path": "./syntaxes/pytae.tmLanguage.json",
        "injectTo": [
          "source.python"
        ]
      }
    ],
    "snippets": [
      {
        "language": "python",
        "path": "./snippets/snippets.json"
      }
    ],
    "themes": [
      {
        "label": "Pytae Dark Green",
        "uiTheme": "vs-dark",
        "path": "./themes/pytae-dark-green.json"
      }
    ],
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": [
              "source.pytae",
              "meta.embedded.pytae"
            ],
            "settings": {
              "foreground": "#52b788"
            }
          },
          {
            "scope": [
              "support.function.pytae"
            ],
            "settings": {
              "foreground": "#40916c",
              "fontStyle": "bold"
            }
          },
          {
            "scope": [
              "variable.other.assignment.pytae",
              "meta.target.multi.pytae"
            ],
            "settings": {
              "foreground": "#2d6a4f",
              "fontStyle": "bold"
            }
          },
          {
            "scope": [
              "variable.parameter.pytae",
              "variable.other.bracketed.pytae",
              "variable.other.backtick.pytae"
            ],
            "settings": {
              "foreground": "#74c69d"
            }
          },
          {
            "scope": [
              "keyword.control.pytae"
            ],
            "settings": {
              "foreground": "#1b4332",
              "fontStyle": "bold"
            }
          },
          {
            "scope": [
              "keyword.operator.pytae"
            ],
            "settings": {
              "foreground": "#95d5b2"
            }
          },
          {
            "scope": [
              "constant.numeric.pytae"
            ],
            "settings": {
              "foreground": "#b7e4c7"
            }
          },
          {
            "scope": [
              "string.quoted.single.pytae",
              "string.quoted.double.pytae"
            ],
            "settings": {
              "foreground": "#ffd166"
            }
          }
        ]
      }
    }
  }
}
