{
  "Pytae Mutate Expression": {
    "prefix": "pt-mutate",
    "body": [
      ".mutate(\"${1:new_col} = ${2:expression}\")"
    ],
    "description": "Pytae mutate expression"
  },
  "Pytae Multi-line Mutate": {
    "prefix": "pt-mutate-multi",
    "body": [
      ".mutate(\"\"\"",
      "    ${1:col1} = ${2:expr1},",
      "    ${3:col2} = ${4:expr2}",
      "\"\"\")"
    ],
    "description": "Pytae multi-line mutate block"
  },
  "Pytae Case When": {
    "prefix": "pt-case-when",
    "body": [
      "case_when((${1:condition}, ${2:'value'}), default=${3:'default'})"
    ],
    "description": "Pytae case_when vectorized conditional expression"
  },
  "Pytae If Else": {
    "prefix": "pt-if-else",
    "body": [
      "if_else(${1:condition}, ${2:true_val}, ${3:false_val})"
    ],
    "description": "Pytae if_else expression"
  },
  "Pytae Filter": {
    "prefix": "pt-filter",
    "body": [
      ".filter(\"${1:column} == '${2:value}'\")"
    ],
    "description": "Pytae filter condition"
  },
  "Pytae Select": {
    "prefix": "pt-select",
    "body": [
      ".select(\"!${1:col_to_exclude}\", \"${2:col_to_keep}\")"
    ],
    "description": "Pytae select with canonical ! negation"
  },
  "Pytae Arrange": {
    "prefix": "pt-arrange",
    "body": [
      ".arrange(\"${1:column} ${2|desc,asc|}\")"
    ],
    "description": "Pytae arrange row sorting"
  },
  "Pytae Agg": {
    "prefix": "pt-agg",
    "body": [
      ".by(\"${1:group_col}\").agg(\"${2:total} = count, ${3:avg_val} = ${4:val_col}:mean\")"
    ],
    "description": "Pytae group aggregation"
  },
  "Pytae Validate Pipeline": {
    "prefix": "pt-validate",
    "body": [
      "output_schema = pt.validate_pipeline(${1:my_pipeline}, ${2:schema_or_path})"
    ],
    "description": "Pre-flight zero-data pipeline schema and DSL validator"
  },
  "Pytae Pipeline Template": {
    "prefix": "pt-pipeline",
    "body": [
      "import pytae as pt",
      "",
      "def ${1:process_data}(df: pt.DataFrame) -> pt.DataFrame:",
      "    return (",
      "        df.filter(\"${2:status} == 'ACTIVE'\")",
      "        .mutate(\"\"\"",
      "            ${3:derived_metric} = ${4:x} * 1.2,",
      "            ${5:category} = case_when((${4:x} > 100, 'High'), default='Normal')",
      "        \"\"\")",
      "        .select(\"!${6:raw_col}\")",
      "    )",
      "",
      "# Zero-data pre-flight validation:",
      "pt.validate_pipeline(${1:process_data}, \"${7:data.parquet}\")"
    ],
    "description": "Complete Pytae lazy pipeline template with pre-flight validation"
  }
}
